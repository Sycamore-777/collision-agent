# Basic runtime
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./data/app.db

# File storage
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
PARSED_DIR=./data/parsed
REPORT_DIR=./data/reports
TRACE_DIR=./data/traces
MOCK_DIR=./data/mock
PROMPT_DIR=./prompts

# External data
CELESTRAK_BASE_URL=https://celestrak.org
SPACE_TRACK_ENABLED=false
SPACE_TRACK_BASE_URL=
SPACE_TRACK_USERNAME=
SPACE_TRACK_PASSWORD=

# Parser backend
PARSER_BACKEND=mock
MINERU_BASE_URL=
MINERU_API_KEY=
MINERU_TIMEOUT=120

# LLM settings
LLM_ENABLED=true
LLM_PROVIDER=openai_compatible
MODEL_NAME=
BASE_URL=
API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120
LLM_TOP_P=1.0
LLM_MODEL_FOR_ACTION=
LLM_MODEL_FOR_SUMMARY=
LLM_MODEL_FOR_REPORT=
LLM_MODEL_FOR_REVIEW=

# Prompt behavior
PROMPT_LANG=zh-CN
PROMPT_STRICT_JSON=true

# Feature flags
ENABLE_EXTERNAL_CONTEXT=true
ENABLE_LLM_SUGGESTION=true
ENABLE_REPORT_GENERATION=true
ENABLE_MANUAL_REVIEW_ROUTE=true
